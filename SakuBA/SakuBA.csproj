<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\Saku Overclock\Version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Saku Overclock\Version.props')" />
  
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SakuBA</AssemblyName>
    <RootNamespace>SakuBA</RootNamespace>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>false</SelfContained>
    <ClientVersion Condition="'$(ClientVersion)' == ''">1.1.0.0</ClientVersion>
    <AssemblyVersion>$(ClientVersion)</AssemblyVersion>
    <FileVersion>$(ClientVersion)</FileVersion>
    <Version>$(ClientVersion)</Version>
    <RollForward>Major</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\StoreLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="7.0.0" />
  </ItemGroup>
</Project>
